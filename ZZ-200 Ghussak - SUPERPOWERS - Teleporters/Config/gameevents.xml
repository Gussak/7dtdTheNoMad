<?xml version="1.0"?>
<GhussakTweaks>
  <append xpath="/gameevents">
    <action_sequence name="eventGSKteleportPortalExplosion">
      <property name="allow_user_trigger" value="true"/>
      <property name="action_type" value="Game"/>
      <action class="ExplodeTarget">
        <property name="blast_power" value="75"/>
        <property name="block_damage" value="32000"/>
        <property name="block_radius" value="1.0" help="mainly to just destroy the portal itself and not to dig far. 1.5 if player is placed on the edge of the tiny 1 block portal still did not work, 1.0 will not hit it"/>
        <property name="entity_damage" value="32000" help="TODO: why this doesnt work?"/>
        <property name="entity_radius" value="3.0" help="a bit more than block_radius, can be used as weapon"/>
      </action>
    </action_sequence>
    <!-- HELPGOOD:
    <action_sequence name="eventGSKteleportPortalParadoxKillsPlayer">
      <property name="allow_user_trigger" value="true"/>
      <property name="action_type" value="Game"/>
