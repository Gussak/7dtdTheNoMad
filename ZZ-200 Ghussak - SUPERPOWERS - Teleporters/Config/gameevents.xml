        <property name="phase" value="30"/>
        <property name="blast_power" value="75"/>
        <property name="block_damage" value="32000"/>
        <property name="block_radius" value="3"/>
        <property name="entity_damage" value="32000"/>
        <property name="entity_radius" value="3"/>
      </action>
    </action_sequence>
-->
    <action_sequence name="eventGSKElctrnTeleCopy" help="TODO: directional teleportations will require proper prior BlockReplace to work well when teleporting to invalid locations like inside terrain or inside a massive mass of blocks">
      <property name="allow_user_trigger" value="true"/>
      <property name="action_type" value="Game"/>
      <!--
      HELPGOOD:
      explosion MUST BE JUST AFTER TELEPORT TO PREVENT PLAYER HAVING TIME TO FALL TOO MUCH.
      disintegrates blocks to let a safe teleport.
      ExplodeTarget seems to require the player to be in somewhere valid, be standing somewhere or falling in air (not in an invalid location like inside/below the terrain), ExplodePosition too...
-->
      <!-- HELPGOOD
      <action class="ExplodePosition" help="FAIL: trying to explode where the player will teleport to while the player is standing on the ground">
        <property name="phase" value="10" />
        <property name="position" value="0,0,0" param1="v3Dir" help="ISSUE: is ignored?"/>
        <property name="target_position" value="0,0,0" param1="v3Dir" help="ISSUE: is ignored?"/>
        <property name="offset_type" value="Relative" help="ISSUE: is ignored?"/>
        <property name="blast_power" value="75" />
        <property name="block_damage" value="32000" param1="iXplodDmgBlk"/>
        <property name="block_radius" value="1" param1="iXplodRangeBlock"/>
        <property name="entity_damage" value="0" />
        <property name="entity_radius" value="0" />
      </action>
-->
      <action class="Teleport">
        <property name="phase" value="13"/>
        <property name="target_position" value="0,0,0" param1="v3Dir"/>
        <property name="offset_type" value="Relative"/>
      </action>
      <action class="ExplodeTarget" help="will not explode around the player after teleport to an invalid location (inside the terrain and not stepping over it even if in an underground cave)">
        <property name="phase" value="16"/>
        <property name="blast_power" value="75"/>
        <property name="block_damage" value="32000" param1="iXplodDmgBlk"/>
        <property name="block_radius" value="1" param1="iXplodRangeBlock"/>
        <property name="entity_damage" value="0"/>
        <property name="entity_radius" value="0"/>
      </action>
      <action class="ModifyCVar">
        <property name="phase" value="19"/>
        <property name="cvar" value=".bGSKEventFeedbackTeleportCompleted"/>
        <property name="value" value="1"/>
        <property name="operation" value="Set"/>
      </action>
      <!-- HELPGOOD: ragdoll here is not good as it just creates a fall damage prevention (ragdoll does not take fall damage right?)
      <action class="Ragdoll">
        <property name="phase" value="20" />
        <property name="stun_duration" value="0.5" />
      </action>
      <action class="ModifyCVar">
        <property name="phase" value="20" />
        <property name="cvar" value=".iGSKEventFeedbackTeleportPhase" />
        <property name="value" value="20" help="the phase"/>
        <property name="operation" value="Set"/>
      </action>
-->
      <action class="AddEntitiesToGroup" help="no filter means hostiles">
        <property name="phase" value="30"/>
        <property name="group_name" value="gnHostiles"/>
        <property name="max_distance" value="2" param1="iXplodRangeEnt"/>
      </action>
      <action class="ExplodeTarget" help="kill any hostile entity at teleport destination">
        <property name="phase" value="31"/>
        <property name="target_group" value="gnHostiles"/>
        <property name="blast_power" value="0"/>
        <property name="block_damage" value="0"/>
        <property name="block_radius" value="0"/>
        <property name="entity_damage" value="32000" param1="iXplodDmgEnt"/>
        <property name="entity_radius" value="2" param1="iXplodRangeEnt" help="will only affect selected gnHostiles tho"/>
      </action>
      <action class="ExplodeTarget" help="this is like a sonic damage TODO: make them ragdoll with a good force too">
        <property name="phase" value="40"/>
        <property name="target_group" value="gnHostiles"/>
        <property name="blast_power" value="500" param1="iBlastPower"/>
        <property name="block_damage" value="0"/>
        <property name="block_radius" value="0"/>
        <property name="entity_damage" value="30"/>
        <property name="entity_radius" value="5" param1="iXplodRangeSonicBlastEnt"/>
      </action>
    </action_sequence>
    <action_sequence name="eventGSKteleForwardFar" template="eventGSKElctrnTeleCopy">
      <variable name="v3Dir" value="0,0,300"/>
      <variable name="iXplodRangeBlock" value="2" help="important to open a hole inside mountains ISSUE: doesnt work anymore, it wont explode if player is in an invalid location (below ground mesh)"/>
    </action_sequence>
  </append>
